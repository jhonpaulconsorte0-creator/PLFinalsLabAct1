  function setupUiEventHandlers(tabbedPane, base, socket, projectId) {

    console.log('Adding onclick to button-run');
    document.getElementById('run').onclick = function() {
      console.log('Active Tab path: ' + tabbedPane.activeTabPath);
      console.log(tabbedPane);
      if (tabbedPane.activeTabPath) {
        if (prevDiagnostics) {
          var hasError = prevDiagnostics.reduce(function(init, diag) {
            return init || (diag.kind === 1) || (diag.kind === "ERROR");
          }, false);
          console.log('hasError: ' + hasError);
          if (hasError) {
            var confirmation = confirm('There are compilation errors. Run previous working version?');
            if (!confirmation) {
              return;
            }
          }
        }
        socket.emit('run', { 'fileName': tabbedPane.activeTabPath, 'now': Date.now(), 'clientTime': (new Date()).toUTCString() });
        document.getElementById('consoletoggle').checked = true;
        ga('send', 'event', 'ide', 'run');
      }
    };

    if (document.getElementById('newFileForm') !== null) {
      document.getElementById('newFileForm').onsubmit = function() {
        var fileName = document.getElementById('text-fileName').value;
        var directory = document.getElementById('text-directory').value;
        console.log('directory : ' + directory);
        console.log('fileName : ' + fileName);
        if (/^[0-9a-zA-Z\^\&\'\@\{\}\[\]\,\$\=\!\-\#\(\)\.\%\+\~\_ ]+$/.test(fileName)) {
          console.log("valid filename");
        } else {
          console.log("invalid filename : " + fileName);
          document.getElementById('text-fileName').focus();
          return false;
        }
        if (fileName.indexOf('.') === -1) {
          fileName += '.java'
        }
        base.createNewFile(directory, fileName);
        return false;
      }
    }

    if (document.getElementById('cloneButton') !== null) {
      document.getElementById('cloneButton').onclick = function() {
        console.log('cloneButton clicked: projectId : ' + projectId);
        if (projectId) {
          document.getElementById('cloneProjectId').value = projectId;
        } else {
          document.getElementById('cloneProjectId').value = 'empty0';
        }
        document.getElementById('cloneForm').submit();
        return false;
      }
    }
    var sharetoggle = document.getElementById('sharetoggle');
    if (sharetoggle !== null) {
      sharetoggle.onclick = function() {
        socket.emit('update-sharing-settings', { 'isShared': sharetoggle.checked });
        if (sharetoggle.checked) {
          document.getElementById('sharetogglelabel').innerHTML = 'Unshare';
        } else {
          document.getElementById('sharetogglelabel').innerHTML = 'Share';
        }
      }
    }
  }

  // We need these elements to handle all of the events from the resize dragging.
  const resizer = document.getElementById('dragMe');
  const consoleElement = document.getElementById('console');
  const workbenchElement = document.getElementById('workbench');
  const fileexplorerElement = document.getElementById('fileexplorer');
  const codeMirrorElements = document.getElementsByClassName('CodeMirror');

  // Handle the mousedown event
  // that's triggered when user drags the resizer
  const mouseDownHandler = function(e) {
      console.log(document.body.style.cursor);

      // Make it so that we dont select text in these divs.
      consoleElement.style.userSelect = 'none';
      consoleElement.style.pointerEvents = 'none';

      workbenchElement.style.userSelect = 'none';
      workbenchElement.style.pointerEvents = 'none';

      document.addEventListener('mousemove', mouseMoveHandler);
      document.addEventListener('mouseup', mouseUpHandler);
  };

  const mouseMoveHandler = function(e) {
      // Update the codemirror editor for all tabs.
      let windowHeight = window.innerHeight;
      const minConsoleHeight = 0.2;
      const minEditorHeight = 0.2;

      newConsoleHeight = consoleElement.getBoundingClientRect().bottom - e.clientY - 10
      newEditorHeight = e.clientY - 10 - workbenchElement.getBoundingClientRect().top;

      if (newEditorHeight/windowHeight < minEditorHeight || newConsoleHeight/windowHeight < minConsoleHeight) {
        return;
      }
      for (let i = 0; i < codeMirrorElements.length; i ++ ) {
        codeMirrorElements[i].style.height = (e.clientY - 10 - codeMirrorElements[i].getBoundingClientRect().top).toString() + "px";
      }
      workbenchElement.style.height = (newEditorHeight).toString() + "px";
      fileexplorerElement.style.height = (e.clientY - fileexplorerElement.getBoundingClientRect().top).toString() + "px";
      consoleElement.style.height = (newConsoleHeight).toString() + "px";
      consoleElement.style.top = (e.clientY + 10).toString() + "px";
  };

  const mouseUpHandler = function() {

    consoleElement.style.removeProperty('user-select');
    consoleElement.style.removeProperty('pointer-events');

    workbenchElement.style.removeProperty('user-select');
    workbenchElement.style.removeProperty('pointer-events');

    document.removeEventListener('mousemove', mouseMoveHandler);
    document.removeEventListener('mouseup', mouseUpHandler);
  };

  // Attach the handler
  resizer.addEventListener('mousedown', mouseDownHandler);

  window.addEventListener('load', onLoad);
  window.addEventListener('DOMContentLoaded', onDOMContentLoaded);
  </script>
