      console.log(fileTextBox.value);
      console.log(fileTextBox.dataset);
      console.log(fileTextBox.dataset.basepath);
      console.log(fileTextBox.dataset.filename);

      socket.emit('rename-file', { 'newFileName': fileTextBox.dataset.basepath + "/" + fileTextBox.value, 'oldFileName': fileTextBox.dataset.basepath + "/" + fileTextBox.dataset.filename, 'oldFileId': fileId });
