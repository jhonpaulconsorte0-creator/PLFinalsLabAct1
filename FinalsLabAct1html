  function setupModel(model, handlers, socket) {
    // setup the model class that maintains the common data
    let isReadOnly = false;
    console.log("init model object1");
    model.lang = "";
    model.java = {};
    model.c = {};
    model.cpp = {};

    model.java.moduleNames = new Set();
    model.java.modules = new Map();
    model.java.packageNames = new Set();
    model.java.hasJavaFilesWithoutModule = false;
    model.dirPrefixes = new Set();

    model.updateFilesTree = function(folderData) {
      if (isReadOnly) {
        console.log("Model not required for readonly projects.");
        return;
      }
      var dirDataListOptionsHtml = '';
      var javaModuleNamesDataListOptionsHtml = '';
      var javaPackageNamesDataListOptionsHtml = '';
      var defaultDirectory = '';

      function processFolderData(prefix, dirName, subFolders, hasModule) {
        if (!model.dirPrefixes.has(prefix)) {
          dirDataListOptionsHtml += '<option value="' + prefix + '/" />';
          model.dirPrefixes.add(prefix);
        }
        for (let i = 0; subFolders && i < subFolders.length; i++) {
          let subDir = subFolders[i];
          let hasModuleInfoFile = false;
          let hasJavaFile = false;
          let packageName = "";
          for (let j = 0; subDir.files && j < subDir.files.length; j++) {
            let file = subDir.files[j];
            console.log("prefix: " + prefix + ", dir: " + subDir.displayName + ", file: ", file);
            if (prefix === "src" && file.displayName === 'module-info.java' && !model.java.moduleNames.has(file.displayName)) {
              javaModuleNamesDataListOptionsHtml += '<option value="' + subDir.displayName + '" />\n';
              model.java.moduleNames.add(subDir.displayName);
              hasModuleInfoFile = true;
            }
            if (file.displayName && file.displayName.endsWith(".java")) {
              hasJavaFile = true;
              model.lang = "java";
              defaultDirectory = prefix + '/' + subDir.displayName;
            }
          }

          if (hasJavaFile && hasModuleInfoFile) {
            // module should not have top level java files
          } else if (hasJavaFile && !hasModuleInfoFile && !hasModule) {
            // no module
            let mergedName = prefix + '/' + subDir.displayName;
            packageName = mergedName.split('/').splice(1).join('.');
            model.java.hasJavaFilesWithoutModule = true;
          } else if (hasJavaFile && !hasModuleInfoFile && hasModule) {
            // within package inside a module
            let mergedName = prefix + '/' + subDir.displayName;
            packageName = mergedName.split('/').splice(2).join('.');
          }
          if (packageName !== "" && !model.java.packageNames.has(packageName)) {
            javaPackageNamesDataListOptionsHtml += '<option value="' + packageName + '" />\n';
            model.java.packageNames.add(packageName);
          }
          processFolderData(prefix + '/' + subDir.displayName, subDir.displayName, subDir.subFolders, hasModule || hasModuleInfoFile);
        }
      }
      console.log('Updating files tree');
      for (var i = 0; folderData.subFolders && i < folderData.subFolders.length; i++) {
        var subDir = folderData.subFolders[i];
        if (subDir.displayName === 'src' || subDir.displayName === 'test') {
          for (let j = 0; subDir.files && j < subDir.files.length; j++) {
            let file = subDir.files[j];
            if (file.displayName && file.displayName.endsWith(".java")) {
              model.lang = "java";
              model.java.hasJavaFilesWithoutModule = true;
            }

          }
          console.log(subDir);
          processFolderData(subDir.displayName, subDir.displayName, subDir.subFolders, false);
        }
      }
      console.log('model:', model);
      console.log('dirDataListOptionsHtml: ', dirDataListOptionsHtml);
      console.log('javaModuleNamesDataListOptionsHtml: ', javaModuleNamesDataListOptionsHtml);
      console.log('javaPackageNamesDataListOptionsHtml: ', javaPackageNamesDataListOptionsHtml);
      console.log('defaultDirectory: ', defaultDirectory);
      document.getElementById('directoryList').innerHTML = dirDataListOptionsHtml;
      document.getElementById('packageNameList').innerHTML = javaPackageNamesDataListOptionsHtml;
      document.getElementById('moduleNameList').innerHTML = javaModuleNamesDataListOptionsHtml;
      if (defaultDirectory !== "") {
        document.getElementById('text-directory').value = defaultDirectory;
      }
    };
  }

  function setupHandlers(handlers, socket) {
    // setup callbacks for the UI to trigger updating the server.
    handlers.ready = true;
    handlers.createNewFile = function(fileName, options) {
      if (fileName.startsWith('~/src/') && model.java && model.java.moduleNames) {
        console.log("createNewFile starts with src");
        var res = fileName.split("/");
        if (res.length >= 3) {
          var moduleName = res[2];
          if (model.java.moduleNames.has(moduleName)) {
            console.log("moduleName: " + moduleName);
            options.moduleName = moduleName;
          } else {
            console.log("No existing module, moduleName " + moduleName);
          }

        }
      }
      socket.emit('create-file', { 'fileName': fileName, 'options': options });
    };
    handlers.createNewFolder = function() {};
    handlers.deleteFile = function(fileName) {
      console.log("Trying to deletefile : " + fileName);
      socket.emit("delete-file", { 'fileName': fileName });
    };

    handlers.deleteFolder = function() {};
    handlers.renameFile = function(fileId) {
      console.log("Trying to renamefile : " + fileId);
      var fileTextBox = document.getElementById("file-newname-" + fileId);
      if (!fileTextBox) {
